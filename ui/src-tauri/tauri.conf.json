{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://localhost:8000",
    "distDir": "http://localhost:8000",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "NFSe Manager Pro",
    "version": "0.2.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": true,
        "sidecar": true,
        "open": false
      },
      "path": {
        "all": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": false,
        "readDir": true,
        "createDir": false,
        "removeDir": false,
        "removeFile": false,
        "copyFile": false,
        "exists": true,
        "scope": [
          "$APPDATA",
          "$APPDATA/**",
          "$HOME/.config/nfse-manager/**"
        ]
      },
      "notification": {
        "all": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "br.com.nfse.manager",
      "publisher": "Cleiton Leonel",
      "copyright": "Copyright (c) 2026 Cleiton Leonel",
      "category": "Productivity",
      "shortDescription": "Gestão, emissão ADN v1.01 e sincronização de NFS-e Nacional",
      "longDescription": "Sistema multiusuário para escritórios contábeis e empresas realizarem a gestão centralizada de NFS-e Nacional (Sefin Nacional / ADN v1.01 e Reforma Tributária IBS/CBS). Inclui emissão em 1 clique e em lote por planilhas (CSV/XLSX), consulta por certificado digital A1 (NSU), geração offline de DANFSe em PDF, catálogos fiscais oficiais atualizáveis (RFB e Portal Nacional) e relatórios financeiros por competência.",
      "deb": {
        "section": "utils",
        "priority": "optional"
      },
      "windows": {
        "wix": {
          "language": "pt-BR"
        },
        "nsis": {
          "languages": [
            "PortugueseBR"
          ],
          "installMode": "both"
        }
      },
      "externalBin": [
        "binaries/server"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico",
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "label": "main",
        "title": "NFSe Manager Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false,
        "url": "http://localhost:8000"
      }
    ],
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}
