# Configurações do Banco de Dados (PostgreSQL)
POSTGRES_DB=nfse_db
POSTGRES_USER=nfse_user
POSTGRES_PASSWORD=nfse_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# String de conexão usada pelo Backend
DATABASE_URL=postgresql+psycopg2://nfse_user:nfse_pass@localhost:5434/nfse_db

# Portas expostas no Host
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Chave Mestra de Criptografia em Repouso para Senhas (Portal e Certificados)
NFSE_ENCRYPTION_KEY=coloque_aqui_uma_chave_secreta_forte_ou_gere_com_fernet

