# Configurações do Banco de Dados (PostgreSQL)
POSTGRES_DB=nfse_db
POSTGRES_USER=nfse_user
POSTGRES_PASSWORD=nfse_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# String de conexão usada pelo Backend
# - No Docker: usa o host interno @database:5432
# - Fora do Docker: converte automaticamente @database para @localhost:<POSTGRES_PORT>
# - Sem PostgreSQL ativo localmente: faz fallback automático para SQLite em backend/nfse.db (se DB_FALLBACK_SQLITE=1)
DATABASE_URL=postgresql+psycopg2://nfse_user:nfse_pass@localhost:5434/nfse_db
DB_FALLBACK_SQLITE=1

# Portas expostas no Host
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Chave Mestra de Criptografia em Repouso para Senhas (Portal, Certificados e SMTP) e JWT
NFSE_ENCRYPTION_KEY=coloque_aqui_uma_chave_secreta_forte_ou_gere_com_fernet
JWT_SECRET_KEY=coloque_aqui_uma_chave_secreta_jwt_forte

# Servidor SMTP Padrão (Fallback quando o cliente/prestador não possuir SMTP próprio configurado)
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASSWORD=
DEFAULT_SMTP_FROM=
DEFAULT_SMTP_TLS=1

# Encaminhamento de Suporte & Feedback (E-mail + Telegram Bot)
SUPPORT_EMAIL_TO=cleiton.leonel@gmail.com
SUPPORT_TELEGRAM_BOT_TOKEN=
# Para envio direto a usuário no Telegram, informe o chat_id numérico após enviar /start para o bot (ex.: via getUpdates)
SUPPORT_TELEGRAM_CHAT_ID=@cleitonLC

# Controle de Auto-cadastro Público e Criação de Empresas por Operadores
# - Em escritórios fechados (produção), defina NFSE_ALLOW_PUBLIC_REGISTER=0 após criar o admin
NFSE_ALLOW_PUBLIC_REGISTER=1
NFSE_ALLOW_OPERATOR_CREATE_CLIENT=1

# Worker Agendado em Background para Retransmissão Automática da Fila de Contingência
AUTO_RETRY_FILA_ENABLED=1
AUTO_RETRY_FILA_INTERVAL_SECONDS=300
AUTO_RETRY_MAX_TENTATIVAS=10

